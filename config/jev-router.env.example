# Jev × Codex 路由配置模板
# 复制到 ~/.codex/jev-router.env 后填写（install.sh 会自动做），并 chmod 600。
# 语法就是 shell 的 KEY=VALUE；代理/启动器启动时读取，已存在的环境变量优先（方便临时覆盖）。

# ── 1. Jev（TypeSafe System One）API key ───────────────────────────────
# 申请：https://console.typesafe.ai/keys
JEV_API_KEY=apikey_replace_me

# ── 2. 四档模型 ───────────────────────────────────────────────────────
# 必须是你 Codex 目录里真实存在的模型名。查法（一次即可）：
#   grep -o '"slug": "[^"]*"' ~/.codex/models_cache.json
JEV_CODEX_FAST_MODEL=gpt-5.6-luna
JEV_CODEX_BALANCED_MODEL=gpt-5.6-terra
JEV_CODEX_STRONG_MODEL=gpt-5.6-sol
JEV_CODEX_HEAVY_MODEL=gpt-6-astra

# 各档的 reasoning effort（只有 JEV_SET_EFFORT=1 / JEVPROXY_SET_EFFORT=1 时才下发）
JEV_EFFORT_FAST=low
JEV_EFFORT_BALANCED=medium
JEV_EFFORT_STRONG=high
JEV_EFFORT_HEAVY=high
JEV_SET_EFFORT=1

# ── 3. 档位阈值（综合分）──────────────────────────────────────────────
# <0.30 fast｜<0.60 balanced｜<0.85 strong｜>=0.85 heavy
JEV_T_FAST=0.30
JEV_T_BALANCED=0.60
JEV_T_STRONG=0.85

# 是否允许升到最高档（0 = 最高只到 strong）
JEV_ALLOW_HEAVY=1

# 置信度门控：Jev 置信度低于 JEV_MIN_CONFIDENCE 且综合分 >= JEV_CONF_FLOOR 时，只上抬一档
JEV_MIN_CONFIDENCE=0.60
JEV_CONF_FLOOR=0.30

# 带图片时强制某档（留空 = 交给 Jev 正常判断）。
# 只有当目录里存在"不支持读图"的模型时才需要设，例如 JEV_IMAGE_FORCE_TIER=fast
JEV_IMAGE_FORCE_TIER=

# jcodex（一次性决策启动器）在 Jev 不可用时的兜底档：keep / fast / balanced / strong / heavy
JEV_FALLBACK=strong

# ── 4. 代理（逐轮改写）────────────────────────────────────────────────
# 转发目标。ChatGPT 订阅登录用这个；用 API key 的话改成 https://api.openai.com/v1
JEVPROXY_UPSTREAM=https://chatgpt.com/backend-api/codex
JEVPROXY_HOST=127.0.0.1
JEVPROXY_PORT=8787

# 哨兵模型：只有请求里的 model 命中它（逗号分隔可多个）时才由 Jev 改写，
# 这样你在 /model 或 App 里显式选别的模型时，代理不会覆盖你的选择。
# 通常填 config.toml 里的顶层 model。
JEVPROXY_SENTINEL=gpt-6-astra

# 「Jev 自动」虚拟模型：注入到 /models 列表里，于是 Codex App / CLI 的模型选择器
# 会多出这一项；选中它 = 每轮交给 Jev。设 JEVPROXY_INJECT_MODELS=0 关闭注入。
JEVPROXY_INJECT_MODELS=1
JEVPROXY_AUTO_MODEL=jev-auto
JEVPROXY_AUTO_NAME=Jev 自动（按难度选模型）
# 克隆哪个已有条目来造它（换模型目录结构时可用）
JEVPROXY_AUTO_TEMPLATE=gpt-5.6-terra

# 代理是否按档改写 reasoning.effort
JEVPROXY_SET_EFFORT=1

# Jev 不可用时代理的策略：keep = 原样放行（不动模型）
JEVPROXY_FALLBACK=keep

# 每轮决策弹一条 macOS 通知（0 关闭）
JEVPROXY_NOTIFY=0

# 调试：记录转发头与改写细节
JEVPROXY_DEBUG=0

# 上传单次请求最长等待（秒）
JEVPROXY_TIMEOUT=900
